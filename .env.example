# Keyframe Character Studio - Environment Configuration
PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/keyframe_studio_db

# Where the REST API listens. The default binds 127.0.0.1, so only this machine
# can reach it. The API has no authentication: setting this to another address
# (for example 0.0.0.0) publishes a writable project store to that network.
KCS_API_HOST=127.0.0.1
